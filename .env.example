# ============================================================
# ERP Astadeca — Environment Variables (TEMPLATE)
# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN commit .env.local (sudah ada di .gitignore).
# ============================================================

# --- Supabase (wajib) ---
# URL project Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Anon/public key (aman untuk client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Publishable key (opsional, untuk client SDK baru)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# --- Server-only (jangan pernah diekspos ke client) ---
# Service role key — dipakai script provisioning & admin
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Database (untuk scripts test/migrasi) ---
# Format: postgresql://postgres.<ref>:<password>@<host>:5432/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Test (opsional, untuk scripts/test-auth-rls.mjs) ---
# Password user demo; hanya dipakai untuk pengujian lokal/CI
TEST_PW_DRPRAMADIA=
TEST_PW_RATIH=
TEST_PW_GIAN=
TEST_PW_SISWOKO=

# --- Provisioning (opsional, untuk scripts/create-*.mjs) ---
WAREHOUSE_SISWOKO_PASSWORD=
WAREHOUSE_SYAIFUL_PASSWORD=
ADMIN_PASSWORD=
DIRECTOR_PASSWORD=
SUPERADMIN_PASSWORD=
